#!/bin/sh
# autostart: Bluetooth LE sensor bridge (bled).
# Brings hci0 up the way Govee's /etc/bluetooth/bt_init.sh did (rfkill reset + rtk_hciattach on ttyS1, H5),
# keeps the controller non-connectable/non-discoverable, then runs bled (passive scan only) and restarts it.
# Disable: put "enabled=0" in /data/custom/ble.conf (takes effect at next boot, or kill this script + bled).
C=/data/custom
LOG=$C/ble.log
export TZ="$(cat /data/custom/tz 2>/dev/null || echo UTC0)"   # see /data/custom/tz
grep -q '^enabled=0' $C/ble.conf 2>/dev/null && { echo "ble: disabled in ble.conf"; exit 0; }
[ -f $LOG ] && [ $(wc -c < $LOG) -gt 65536 ] && mv $LOG $LOG.old

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') ble: $*" >> $LOG; }

bt_rfkill() {  # the rfkill switch named sunxi-bt (rfkill0 on this board)
    for r in /sys/class/rfkill/rfkill*; do
        [ "$(cat $r/name 2>/dev/null)" = "sunxi-bt" ] && { echo $r; return; }
    done
    echo /sys/class/rfkill/rfkill0
}

hci_up() {
    killall rtk_hciattach 2>/dev/null; sleep 1
    R=$(bt_rfkill)
    echo 0 > $R/state; sleep 1
    echo 1 > $R/state; sleep 1
    rtk_hciattach -n -s 115200 /dev/ttyS1 rtk_h5 > /tmp/rtk_hciattach.log 2>&1 &
    i=0
    while [ ! -d /sys/class/bluetooth/hci0 ]; do
        usleep 100000; i=$((i + 1))
        [ $i -ge 100 ] && { log "hci0 did not appear (see /tmp/rtk_hciattach.log)"; return 1; }
    done
    sleep 2
    hciconfig hci0 up || { log "hciconfig hci0 up failed"; return 1; }
    hciconfig hci0 noscan   # no BR/EDR page/inquiry scan: nothing can find or connect to us
    log "hci0 up ($(hciconfig hci0 | sed -n 's/.*BD Address: \([0-9A-F:]*\).*/\1/p'))"
    return 0
}

sleep 20   # let Wi-Fi and pixeld settle first
fails=0
while true; do
    ok=1
    if ! pidof rtk_hciattach > /dev/null || [ ! -d /sys/class/bluetooth/hci0 ]; then
        hci_up || ok=0
    else
        hciconfig hci0 up; hciconfig hci0 noscan
    fi
    if [ $ok = 1 ]; then
        t0=$(date +%s)
        $C/apps/bled >> $LOG 2>&1
        log "bled exited ($?)"
        [ $(( $(date +%s) - t0 )) -gt 600 ] && fails=0
        killall rtk_hciattach 2>/dev/null   # re-init the radio on the next round
    fi
    fails=$((fails + 1))
    d=$((fails * 15)); [ $d -gt 900 ] && d=900
    sleep $d
done
