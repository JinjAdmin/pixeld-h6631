PXS1
# 3D printer: scrolling name, big percentage, a printer whose part grows and whose print head rises with it,
# progress bar, time left, layers.
# Shows while printing, paused or preparing, and for 30 min after a finish or failure the display saw happen.
# Values: printer.status .name .progress .layer .layers .remaining .nozzle .bed .end_time (see 3D printer.bindings.md)
# Icons: printer_head, printer_head_still (examples/icons, original art; upload them to the display's icon library)
name    3D printer
needs   printer.status printer.progress
show    printer.status in running,pause,prepare
linger  printer.status in finish,failed 30m
stale   1h
order   30

# Name (scrolls when it's wider than the panel)
text 0 0 w=52 font=tiny align=center overflow=scroll color=#9696af "{printer.name|replace:_= |upper|or:3D PRINT}"

# --- Printer, 14x15 at (37,7): frame, bed, the part growing with progress ---
rect 37 7 14 15 color=#505564
line 39 19 48 19 color=#787887
bar  41 11 6 8 value=printer.progress dir=up fill=#3cd278

# Print head (gantry + nozzle) above the part, in four steps. It moves while printing or preparing, else it's parked.
icon 38 14 printer_head if="printer.status in running,prepare && printer.progress<25"
icon 38 12 printer_head if="printer.status in running,prepare && printer.progress>=25 && printer.progress<50"
icon 38 10 printer_head if="printer.status in running,prepare && printer.progress>=50 && printer.progress<75"
icon 38 8  printer_head if="printer.status in running,prepare && printer.progress>=75"
icon 38 14 printer_head_still if="printer.status in pause,finish,failed && printer.progress<25"
icon 38 12 printer_head_still if="printer.status in pause,finish,failed && printer.progress>=25 && printer.progress<50"
icon 38 10 printer_head_still if="printer.status in pause,finish,failed && printer.progress>=50 && printer.progress<75"
icon 38 8  printer_head_still if="printer.status in pause,finish,failed && printer.progress>=75"

# --- Big status area ---
text 0 7 w=29 h=14 align=right valign=bottom font=big overflow=shrink color="printer.status==pause:#ffcd3c;#ffffff" "{printer.progress|int}" if="printer.status in running,pause"
text 30 14 font=small color="printer.status==pause:#ffcd3c;#ffffff" "%" if="printer.status in running,pause"
text 1 9 font=tiny color=#ffcd3c "PREPARING" if=printer.status==prepare
text 1 16 font=tiny color=#ffa046 "N{printer.nozzle|int} B{printer.bed|int}" if=printer.status==prepare
text 3 11 font=small color=#3cdc78 "DONE!" if=printer.status==finish
text 1 11 font=small color=#ff3c3c "FAILED" if=printer.status==failed

# --- Progress bar ---
bar 0 23 52 3 value=printer.progress fill=#00a0ff..#28e678 bg=#1e1e2a pulse=1 if="printer.status in running,prepare"
bar 0 23 52 3 value=printer.progress fill=#ffcd3c bg=#1e1e2a if=printer.status==pause
bar 0 23 52 3 value=printer.progress fill=#00a0ff..#28e678 bg=#1e1e2a if=printer.status==finish
bar 0 23 52 3 value=printer.progress fill=#ff3c3c bg=#1e1e2a if=printer.status==failed

# --- Bottom row ---
text 0 27 w=30 font=tiny color=#ffa046 "{printer.remaining|dur:min}" if=printer.status==running
text 1 27 font=tiny color=#ffcd3c blink=500 "PAUSED" if=printer.status==pause
text 1 27 font=tiny color=#8c8ca0 "{printer.end_time|ago}" if="printer.status in finish,failed"
text 26 27 w=26 font=tiny align=right color=#8c8ca0 "{printer.layer}/{printer.layers}" if="printer.status in running,pause"
